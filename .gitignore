# ==========================================
# .gitignore - Landing Page Alfabetização
# ==========================================

# Arquivos do Sistema Operacional (Windows / macOS / Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Ambientes e Editores (VS Code, JetBrains, Sublime, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-project
*.sublime-workspace

# Logs e Arquivos Temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak

# Dependências e Builds (caso sejam adicionados no futuro)
node_modules/
dist/
build/
.cache/

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.*.local
*.pem
*.key

# Pastas de IDE e Assistentes de IA
.agents/
.gemini/
